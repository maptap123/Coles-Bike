TRACKER_SITE_URL=https://your-site.vercel.app
TRACKER_UPDATE_SECRET=replace-with-your-secret

SMARTTHINGS_FIND_URL=https://smartthingsfind.samsung.com/
SCRAPER_INTERVAL_MINUTES=30
SCRAPER_WAIT_FOR_LOGIN=false

# Use these after inspecting the SmartThings Find page.
# If the page text contains raw coordinates, these may not be needed.
SMARTTHINGS_LOCATION_SELECTOR=
SMARTTHINGS_LAT_SELECTOR=
SMARTTHINGS_LNG_SELECTOR=
SMARTTHINGS_PLACE_SELECTOR=
SMARTTHINGS_PLACE_LABEL=Latest bag location
